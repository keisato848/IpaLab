{
    "name": "@ipa-lab/data",
    "version": "1.0.0",
    "private": true,
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "scripts": {
        "repair-json": "ts-node src/scripts/repair-json-files.ts",
        "clean-fe": "ts-node src/scripts/clean-fe-json.ts",
        "fix-answers": "ts-node src/scripts/fix-answers.ts",
        "fill-explanations": "ts-node src/scripts/fill-missing-explanations.ts",
        "scrape": "ts-node src/scraper/index.ts",
        "download": "ts-node src/scraper/download.ts",
        "audit:raw-pdfs": "ts-node src/scripts/audit-raw-pdfs.ts",
        "parse": "ts-node src/scraper/parse.ts",
        "extract:answers:ollama": "node --require ts-node/register src/scripts/ollama-extract-answers.ts",
        "generate-samples": "ts-node src/scripts/generate-samples.ts",
        "sync": "npx ts-node src/syncer/index.ts",
        "sync-db": "npx ts-node src/scripts/sync-db.ts",
        "clean-records": "npx ts-node src/scripts/sync-db.ts clean",
        "verify-coverage": "npx ts-node src/scripts/verify-data-coverage.ts",
        "cleanse": "ts-node src/scripts/cleanse-pm-data.ts",
        "extract": "ts-node src/scripts/run-extract.ts",
        "fix-cats": "ts-node src/scripts/fix-subcategories.ts",
        "transform-batch": "ts-node src/scripts/transform-batch-sc-pm.ts",
        "test-gemini": "ts-node src/scripts/test-gemini.ts",
        "transform-single": "ts-node src/scripts/transform-single-sc-pm.ts",
        "retry-sc": "ts-node src/scripts/retry-sc-pm.ts",
        "final-fix": "ts-node src/scripts/final-fix-sc-pm.ts",
        "force-sc": "ts-node src/scripts/force-complete-sc-2023.ts",
        "force-atomic": "ts-node src/scripts/force-complete-sc-2023-atomic.ts",
        "fix-sc-q1": "ts-node src/scripts/fix-sc-2023-q1.ts",
        "probe": "ts-node src/scripts/probe-models.ts",
        "process-exams": "ts-node src/scripts/process-exams.ts",
        "lint": "eslint . --ext .ts"
    },
    "dependencies": {
        "@azure/cosmos": "^4.9.0",
        "@google/genai": "^1.38.0",
        "@ipa-lab/shared": "*",
        "@napi-rs/canvas": "^0.1.100",
        "axios": "^1.6.0",
        "dotenv": "^16.4.5",
        "json5": "^2.2.3",
        "pdfjs-dist": "^5.7.284"
    },
    "devDependencies": {
        "@types/glob": "^8.1.0",
        "ts-node": "^10.9.2"
    }
}
