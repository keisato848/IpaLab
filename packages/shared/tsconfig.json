{
    "extends": "../config/tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "noEmit": false,
        "declaration": true,
        "module": "Node16",
        "ignoreDeprecations": "5.0",
        "moduleResolution": "Node16",
        "paths": {
            "@ipa-lab/shared": [
                "./src/index"
            ]
        }
    },
    "include": [
        "src/**/*"
    ]
}