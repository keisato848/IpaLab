#!/usr/bin/env sh

# =============================================================
# pre-push hook
# プッシュ前にローカルテストの実行を必須とする
# - ユニットテスト (vitest)
# ユニットテストが失敗した場合、プッシュを中止する
# E2Eテストはこのフックでは実行しない（自動実行の有無は別途CI設定に依存）
# =============================================================

echo "🧪 プッシュ前テストを実行中..."

# ユニットテスト (vitest)
echo "── ユニットテスト (vitest) ──"
npm run test:unit
UNIT_EXIT=$?

if [ $UNIT_EXIT -ne 0 ]; then
  echo "❌ ユニットテストが失敗しました。プッシュを中止します。"
  exit 1
fi
echo "✅ ユニットテスト OK"

echo "🎉 すべてのテストが成功しました。プッシュを続行します。"
