#!/usr/bin/env sh

# =============================================================
# pre-push hook
# プッシュ前にローカルテストの実行を必須とする
# - ユニットテスト (vitest)
# - E2Eテスト (playwright)
# いずれかが失敗した場合、プッシュを中止する
# =============================================================

echo "🧪 プッシュ前テストを実行中..."

# ユニットテスト (vitest)
echo "── ユニットテスト (vitest) ──"
npm run test:unit
UNIT_EXIT=$?

if [ $UNIT_EXIT -ne 0 ]; then
  echo "❌ ユニットテストが失敗しました。プッシュを中止します。"
  exit 1
fi
echo "✅ ユニットテスト OK"

# E2Eテスト (playwright)
echo "── E2Eテスト (playwright) ──"
npm run test:e2e
E2E_EXIT=$?

if [ $E2E_EXIT -ne 0 ]; then
  echo "❌ E2Eテストが失敗しました。プッシュを中止します。"
  exit 1
fi
echo "✅ E2Eテスト OK"

echo "🎉 すべてのテストが成功しました。プッシュを続行します。"
