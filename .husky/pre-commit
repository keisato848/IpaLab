#!/usr/bin/env sh

# =============================================================
# pre-commit hook
# 軽量ガード (静的チェックのみ・テストは pre-push で実行)
# =============================================================

# 過去インシデント (PR #230) の再発防止: 午後試験データ防壁の静的チェック
echo "🛡️  Exam-data fallback guard を実行中..."
node scripts/guard-exam-data-fallback.mjs
GUARD_EXIT=$?

if [ $GUARD_EXIT -ne 0 ]; then
  echo "❌ ガードチェックに失敗しました。コミットを中止します。"
  exit 1
fi

# ESLint: button-has-type / アクセシビリティ違反を静的チェック
echo "🔍 ESLint を実行中..."
cd apps/web && npx eslint app components hooks lib --ext .ts,.tsx 2>&1
ESLINT_EXIT=$?
cd ../..

if [ $ESLINT_EXIT -ne 0 ]; then
  echo "❌ ESLint エラーが検出されました。コミットを中止します。"
  exit 1
fi
echo "✅ ESLint OK"

echo "🔎 self-inspect を実行中..."
if ! command -v pwsh >/dev/null 2>&1; then
  echo "❌ pwsh が見つからないため self-inspect を実行できません。"
  exit 1
fi

pwsh .github/hooks/self-inspect.ps1 -Mode end -FailOnFinding
INSPECT_EXIT=$?

if [ $INSPECT_EXIT -ne 0 ]; then
  echo "❌ self-inspect に失敗しました。実装変更に対応する docs/ 更新は document-agent が担当します。"
  exit 1
fi
