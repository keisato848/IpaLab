# Copilot Chat OTel / Langfuse ローカル監視用テンプレート。
# scripts/setup-copilot-otel.sh を使う場合、この内容は自動生成される .env の参考値です。
# 実値を入れた .env はコミットしないでください。

# ===== Langfuse コアシークレット =====
# NEXTAUTH_SECRET / SALT : openssl rand -base64 32
# ENCRYPTION_KEY         : openssl rand -hex 32   (64 hex chars)
NEXTAUTH_SECRET=CHANGEME
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME
NEXTAUTH_URL=http://localhost:3000

# ===== Langfuse 初回自動作成 =====
LANGFUSE_INIT_ORG_ID=local-org
LANGFUSE_INIT_ORG_NAME=LocalOrg
LANGFUSE_INIT_PROJECT_ID=copilot-otel
LANGFUSE_INIT_PROJECT_NAME=copilot-otel
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-local
LANGFUSE_INIT_USER_EMAIL=dev@example.com
LANGFUSE_INIT_USER_NAME=Dev
LANGFUSE_INIT_USER_PASSWORD=changeme123

# ===== Copilot Chat OTLP 認証ヘッダー =====
# Basic base64("<public_key>:<secret_key>")
# pk-lf-local / sk-lf-local の場合:
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic cGstbGYtbG9jYWw6c2stbGYtbG9jYWw=
OTEL_LANGFUSE_AUTH_HEADER=Basic cGstbGYtbG9jYWw6c2stbGYtbG9jYWw=

# ===== OTLP Collector =====
# Copilot Chat は Collector に送信し、Collector がローカル Langfuse と任意のリモートへ転送します。
OTEL_LOCAL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_DEVCONTAINER_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# リモートにも転送したい場合だけ設定してください。
# 例: https://otel.example.com/v1/traces
OTEL_REMOTE_EXPORTER_OTLP_ENDPOINT=
# 例: Bearer xxxxx / Basic xxxxx
OTEL_REMOTE_AUTH_HEADER=