# NextAuth.js v4 認証設定
# NEXTAUTH_SECRET: JWT暗号化・CSRF保護に必須。以下のコマンドで生成:
#   openssl rand -base64 32
# ※ 本番環境では必ずランダムな値を設定すること
NEXTAUTH_SECRET="Generate with: openssl rand -base64 32"

# NEXTAUTH_URL: OAuth コールバックURL解決に必須
# ローカル開発: http://localhost:3000
# 本番: https://shikaku-no.com
NEXTAUTH_URL="http://localhost:3000"

# --- GitHub OAuth ---
# 取得元: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Authorization callback URL: {NEXTAUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID="Client ID from GitHub OAuth App"
AUTH_GITHUB_SECRET="Client Secret from GitHub OAuth App"

# --- Google OAuth ---
# 取得元: https://console.cloud.google.com/apis/credentials
# 1. OAuth 同意画面を設定 (User Type: 外部)
# 2. 認証情報 → OAuth クライアント ID → ウェブアプリケーション
# 承認済みの JavaScript 生成元: {NEXTAUTH_URL}
# 承認済みのリダイレクト URI: {NEXTAUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID="Client ID from Google Cloud Console"
AUTH_GOOGLE_SECRET="Client Secret from Google Cloud Console"

# Gemini AI API
# Required for AI features (local dev fallback when AI_CHAT_FUNCTION_URL is not set)
# 本番 (East Asia) では Gemini API は地域制限のため使用不可。
# 本番・Staging では AI_CHAT_FUNCTION_URL を設定し、このキーは不要。
# Get your API key from https://ai.google.dev/
GEMINI_API_KEY="Your Gemini API Key"

# AI Chat Function App (US リージョン プロキシ)
# Gemini API は East Asia から直接呼び出せないため、US リージョンの Azure Function を経由する。
# 本番・Staging 環境では必ず設定すること。
# 例: https://func-pm-exam-dx-ai-us.azurewebsites.net/api/ai/chat
AI_CHAT_FUNCTION_URL="https://func-pm-exam-dx-ai-us.azurewebsites.net/api/ai/chat"

# API
NEXT_PUBLIC_API_BASE=http://localhost:7074/api

# --- Google Analytics 4 ---
# GA4 計測 ID（G-XXXXXXXXXX 形式）
# 取得元: https://analytics.google.com/ → 管理 → データストリーム → ウェブ → 計測 ID
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# --- AI Assistant ---
# GitHub Issues 起票用 PAT (repo scope)
GITHUB_ISSUES_TOKEN="Your GitHub PAT"
# 起票先リポジトリ (owner/repo)
GITHUB_ISSUES_REPO="owner/repo"
# Azure Blob Storage (スクリーンショット保存用)
AZURE_BLOB_CONNECTION_STRING="Your Azure Blob Storage Connection String"
AZURE_BLOB_CONTAINER_NAME="ai-assistant-screenshots"
