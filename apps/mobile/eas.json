{
    "cli": {
        "version": ">= 13.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "env": { "APP_ENV": "dev" }
        },
        "preview": {
            "distribution": "internal",
            "android": { "buildType": "app-bundle" },
            "env": { "APP_ENV": "beta" }
        },
        "production": {
            "autoIncrement": true,
            "android": { "buildType": "app-bundle" },
            "env": { "APP_ENV": "prod" }
        }
    },
    "submit": {
        "production": {}
    }
}
