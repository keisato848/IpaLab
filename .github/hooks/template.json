{
	"version": 1,
	"hooks": {
		"sessionStart": [
			{
				"type": "command",
				"powershell": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/.github/hooks/self-inspect.ps1\" -Mode start"
			}
		],
		"sessionEnd": [
			{
				"type": "command",
				"powershell": "pwsh -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}/.github/hooks/self-inspect.ps1\" -Mode end"
			}
		],
		"PreToolUse": [
			{
				"type": "command",
				"command": "pwsh -NoProfile -ExecutionPolicy Bypass -File .github/hooks/ban-gh-pr-merge.ps1",
				"windows": "pwsh -NoProfile -ExecutionPolicy Bypass -File .github/hooks/ban-gh-pr-merge.ps1",
				"timeout": 10
			}
		]
	}
}